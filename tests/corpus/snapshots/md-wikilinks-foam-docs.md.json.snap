{
  "body": [
    {
      "anchor": "h:wikilinks",
      "inlines": [
        {
          "text": "Wikilinks",
          "type": "text"
        }
      ],
      "level": 1,
      "type": "heading"
    },
    {
      "inlines": [
        {
          "text": "Wikilinks are internal links that connect files in your knowledge base using ",
          "type": "text"
        },
        {
          "text": "[[double bracket]]",
          "type": "code"
        },
        {
          "text": " syntax.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "anchor": "h:creating-wikilinks",
      "inlines": [
        {
          "text": "Creating Wikilinks",
          "type": "text"
        }
      ],
      "level": 2,
      "type": "heading"
    },
    {
      "items": [
        [
          {
            "inlines": [
              {
                "strong": true,
                "text": "Type ",
                "type": "text"
              },
              {
                "text": "[[",
                "type": "code"
              },
              {
                "text": " and start typing a note name",
                "type": "text"
              }
            ],
            "type": "paragraph"
          }
        ],
        [
          {
            "inlines": [
              {
                "strong": true,
                "text": "Select from autocomplete",
                "type": "text"
              },
              {
                "text": " and press ",
                "type": "text"
              },
              {
                "text": "Tab",
                "type": "code"
              }
            ],
            "type": "paragraph"
          }
        ],
        [
          {
            "inlines": [
              {
                "strong": true,
                "text": "Navigate",
                "type": "text"
              },
              {
                "text": " with ",
                "type": "text"
              },
              {
                "text": "Ctrl+Click",
                "type": "code"
              },
              {
                "text": " (",
                "type": "text"
              },
              {
                "text": "Cmd+Click",
                "type": "code"
              },
              {
                "text": " on Mac) or ",
                "type": "text"
              },
              {
                "text": "F12",
                "type": "code"
              }
            ],
            "type": "paragraph"
          }
        ],
        [
          {
            "inlines": [
              {
                "strong": true,
                "text": "Create new notes",
                "type": "text"
              },
              {
                "text": " by clicking on non-existent wikilinks",
                "type": "text"
              }
            ],
            "type": "paragraph"
          }
        ]
      ],
      "ordered": true,
      "type": "list"
    },
    {
      "inlines": [
        {
          "text": "Example: ",
          "type": "text"
        },
        {
          "inlines": [
            {
              "text": "graph-view",
              "type": "text"
            }
          ],
          "internal": true,
          "target": "graph-view",
          "type": "link"
        }
      ],
      "type": "paragraph"
    },
    {
      "anchor": "h:placeholders",
      "inlines": [
        {
          "text": "Placeholders",
          "type": "text"
        }
      ],
      "level": 2,
      "type": "heading"
    },
    {
      "inlines": [
        {
          "text": "Wikilinks to non-existent files create placeholder links, styled differently to show they need files created. They're useful for planning your knowledge structure.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "inlines": [
        {
          "text": "View placeholders in the graph with ",
          "type": "text"
        },
        {
          "text": "Foam: Show Graph",
          "type": "code"
        },
        {
          "text": " command or in the ",
          "type": "text"
        },
        {
          "text": "Placeholders",
          "type": "code"
        },
        {
          "text": " panel.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "anchor": "h:section-links",
      "inlines": [
        {
          "text": "Section Links",
          "type": "text"
        }
      ],
      "level": 2,
      "type": "heading"
    },
    {
      "inlines": [
        {
          "text": "Link to specific sections using ",
          "type": "text"
        },
        {
          "text": "[[note-name#Section Title]]",
          "type": "code"
        },
        {
          "text": " syntax. Foam provides autocomplete for section titles.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "inlines": [
        {
          "text": "Examples:",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
    {
      "items": [
        [
          {
            "inlines": [
              {
                "text": "External file: ",
                "type": "text"
              },
              {
                "text": "[link text](other-file.md#section-name)",
                "type": "code"
              }
            ],
            "type": "paragraph"
          }
        ],
        [
          {
            "inlines": [
              {
                "text": "Same document: ",
                "type": "text"
              },
              {
                "text": "[link text](#section-name)",
                "type": "code"
              }
            ],
            "type": "paragraph"
          }
        ]
      ],
      "ordered": false,
      "type": "list"
    },
    "<24 more items>"
