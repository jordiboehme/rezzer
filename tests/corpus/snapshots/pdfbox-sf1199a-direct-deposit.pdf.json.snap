                      "start": 0,
                      "strong": true
                    }
                  ],
                  "text": "DIRECT DEPOSIT SIGN-UP FORM"
                }
              ]
            }
          ],
          "type": "spatial"
        },
        {
          "anchor": "p1:b7",
          "inlines": [
            {
              "text": "Treasury Dept. Cir. 1076",
              "type": "text"
            }
          ],
          "role": "page-header",
          "type": "paragraph"
        },
        {
          "anchor": "p1:b8",
          "inlines": [
            {
              "text": "DIRECTIONS",
              "type": "text"
            }
          ],
          "role": "page-header",
          "type": "paragraph"
        },
        {
          "anchor": "p1:b9",
          "inlines": [
            {
              "text": "To sign up for Direct Deposit, the payee is to read the back of this form and fill in the information requested in Sections 1 and 2. Then take or mail this form to the financial institution.  The financial institution will verify the information in Sections 1 and 2, and will complete Section 3. The completed form will be returned to the Government agency identified below.",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "anchor": "p1:b10",
          "inlines": [
            {
              "text": "A separate form must be completed for each type of payment to be sent by Direct Deposit.",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "anchor": "p1:b11",
          "inlines": [
            {
              "text": "The claim number and type of payment are printed on Government",
              "type": "text"
            }
          ],
          "role": "page-header",
          "type": "paragraph"
        },
        "<37 more items>"
      ],
      "kind": "page",
      "type": "section"
